{
  "expo": {
    "owner": "your-zeros-and-ones",
    "name": "Sudo Reply",
    "slug": "sudo-reply-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "sudoreply",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#125EF2"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.sudoreply.mobile",
      "infoPlist": {
        "NSContactsUsageDescription": "Sudo Reply needs access to your contacts to import them into your CRM.",
        "NSMicrophoneUsageDescription": "Sudo Reply needs access to your microphone for WhatsApp voice calls and voice notes.",
        "NSCameraUsageDescription": "Sudo Reply needs access to your camera to take photos and send them.",
        "NSPhotoLibraryUsageDescription": "Sudo Reply needs access to your photos to attach and send media files."
      }
    },
        "android": {
      "versionCode": 4,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#125EF2"
      },
      "package": "com.sudoreply.mobile",
      "googleServicesFile": "./google-services.json",
      "blockedPermissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.CAMERA",
        "android.permission.READ_CONTACTS",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "plugins": [
      "expo-secure-store",
      "expo-font",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#125EF2",
          "sounds": []
        }
      ],
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.73639182000-vh6bmq0unbpecadgshv4f1ts883eqnv8"
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36
          }
        }
      ]
    ],
    "extra": {
      "apiUrl": "https://api.sudoreply.com",
      "eas": {
        "projectId": "6292ddf3-0f58-4832-9e8d-6e12f98b62f3"
      }
    }
  }
}